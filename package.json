{
  "name": "dsh-prompt-polish",
  "version": "0.2.0",
  "type": "module",
  "description": "把粗糙提示词转写成规范提示词，确认后写入输入框。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMQ00/dsh-prompt-polish.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
